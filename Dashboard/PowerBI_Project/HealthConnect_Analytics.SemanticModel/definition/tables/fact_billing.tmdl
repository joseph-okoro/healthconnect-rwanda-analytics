table fact_billing

	column billing_id
		dataType: string
		summarizeBy: none
		sourceColumn: billing_id

	column appointment_id
		dataType: string
		summarizeBy: none
		sourceColumn: appointment_id

	column billed_amount
		dataType: int64
		summarizeBy: sum
		sourceColumn: billed_amount

	column paid_amount
		dataType: int64
		summarizeBy: sum
		sourceColumn: paid_amount

	column outstanding_amount
		dataType: int64
		summarizeBy: sum
		sourceColumn: outstanding_amount

	column billing_status
		dataType: string
		summarizeBy: none
		sourceColumn: billing_status

	column payment_method
		dataType: string
		summarizeBy: none
		sourceColumn: payment_method

	column claim_provider
		dataType: string
		summarizeBy: none
		sourceColumn: claim_provider

	column claim_amount
		dataType: double
		summarizeBy: sum
		sourceColumn: claim_amount

	column claim_status
		dataType: string
		summarizeBy: none
		sourceColumn: claim_status

	column link_status
		dataType: string
		summarizeBy: none
		sourceColumn: link_status

	column date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: date

	column facility_id
		dataType: string
		summarizeBy: none
		sourceColumn: facility_id

	column department_name
		dataType: string
		summarizeBy: none
		sourceColumn: department_name

	column visit_type
		dataType: string
		summarizeBy: none
		sourceColumn: visit_type

	column province_name
		dataType: string
		summarizeBy: none
		sourceColumn: province_name

	column patient_id
		dataType: string
		summarizeBy: none
		sourceColumn: patient_id

	partition fact_billing = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_billing.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"billing_id", type text}, {"appointment_id", type text}, {"billed_amount", Int64.Type}, {"paid_amount", Int64.Type}, {"outstanding_amount", Int64.Type}, {"billing_status", type text}, {"payment_method", type text}, {"claim_provider", type text}, {"claim_amount", type number}, {"claim_status", type text}, {"link_status", type text}, {"date", type date}, {"facility_id", type text}, {"department_name", type text}, {"visit_type", type text}, {"province_name", type text}, {"patient_id", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
