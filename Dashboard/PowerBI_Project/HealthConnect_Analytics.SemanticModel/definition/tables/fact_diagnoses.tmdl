table fact_diagnoses

	column diagnosis_id
		dataType: string
		summarizeBy: none
		sourceColumn: diagnosis_id

	column appointment_id
		dataType: string
		summarizeBy: none
		sourceColumn: appointment_id

	column diagnosis
		dataType: string
		summarizeBy: none
		sourceColumn: diagnosis

	column severity
		dataType: string
		summarizeBy: none
		sourceColumn: severity

	column link_status
		dataType: string
		summarizeBy: none
		sourceColumn: link_status

	column date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: date

	column facility_id
		dataType: string
		summarizeBy: none
		sourceColumn: facility_id

	column department_name
		dataType: string
		summarizeBy: none
		sourceColumn: department_name

	column visit_type
		dataType: string
		summarizeBy: none
		sourceColumn: visit_type

	column province_name
		dataType: string
		summarizeBy: none
		sourceColumn: province_name

	column patient_id
		dataType: string
		summarizeBy: none
		sourceColumn: patient_id

	partition fact_diagnoses = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_diagnoses.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"diagnosis_id", type text}, {"appointment_id", type text}, {"diagnosis", type text}, {"severity", type text}, {"link_status", type text}, {"date", type date}, {"facility_id", type text}, {"department_name", type text}, {"visit_type", type text}, {"province_name", type text}, {"patient_id", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
