table fact_admissions

	column admission_id
		dataType: string
		summarizeBy: none
		sourceColumn: admission_id

	column appointment_id
		dataType: string
		summarizeBy: none
		sourceColumn: appointment_id

	column length_of_stay_days
		dataType: int64
		summarizeBy: none
		sourceColumn: length_of_stay_days

	column link_status
		dataType: string
		summarizeBy: none
		sourceColumn: link_status

	column date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: date

	column facility_id
		dataType: string
		summarizeBy: none
		sourceColumn: facility_id

	column department_name
		dataType: string
		summarizeBy: none
		sourceColumn: department_name

	column province_name
		dataType: string
		summarizeBy: none
		sourceColumn: province_name

	column patient_id
		dataType: string
		summarizeBy: none
		sourceColumn: patient_id

	partition fact_admissions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_admissions.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"admission_id", type text}, {"appointment_id", type text}, {"length_of_stay_days", Int64.Type}, {"link_status", type text}, {"date", type date}, {"facility_id", type text}, {"department_name", type text}, {"province_name", type text}, {"patient_id", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
