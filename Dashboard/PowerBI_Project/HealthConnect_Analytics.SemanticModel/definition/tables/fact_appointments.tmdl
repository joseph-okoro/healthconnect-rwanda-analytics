table fact_appointments

	column appointment_id
		dataType: string
		summarizeBy: none
		sourceColumn: appointment_id

	column date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: date

	column visit_type
		dataType: string
		summarizeBy: none
		sourceColumn: visit_type

	column facility_id
		dataType: string
		summarizeBy: none
		sourceColumn: facility_id

	column department_name
		dataType: string
		summarizeBy: none
		sourceColumn: department_name

	column doctor_id
		dataType: string
		summarizeBy: none
		sourceColumn: doctor_id

	column patient_id
		dataType: string
		summarizeBy: none
		sourceColumn: patient_id

	column province_name
		dataType: string
		summarizeBy: none
		sourceColumn: province_name

	column district_name
		dataType: string
		summarizeBy: none
		sourceColumn: district_name

	column was_admitted
		dataType: string
		summarizeBy: none
		sourceColumn: was_admitted

	column length_of_stay_days
		dataType: int64
		summarizeBy: none
		sourceColumn: length_of_stay_days

	column was_referred
		dataType: string
		summarizeBy: none
		sourceColumn: was_referred

	column had_lab_test
		dataType: string
		summarizeBy: none
		sourceColumn: had_lab_test

	column had_prescription
		dataType: string
		summarizeBy: none
		sourceColumn: had_prescription

	column billed_amount
		dataType: int64
		summarizeBy: sum
		sourceColumn: billed_amount

	column paid_amount
		dataType: int64
		summarizeBy: sum
		sourceColumn: paid_amount

	column rating
		dataType: int64
		summarizeBy: sum
		sourceColumn: rating

	partition fact_appointments = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_appointments.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"appointment_id", type text}, {"date", type date}, {"visit_type", type text}, {"facility_id", type text}, {"department_name", type text}, {"doctor_id", type text}, {"patient_id", type text}, {"province_name", type text}, {"district_name", type text}, {"was_admitted", type text}, {"length_of_stay_days", Int64.Type}, {"was_referred", type text}, {"had_lab_test", type text}, {"had_prescription", type text}, {"billed_amount", Int64.Type}, {"paid_amount", Int64.Type}, {"rating", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
