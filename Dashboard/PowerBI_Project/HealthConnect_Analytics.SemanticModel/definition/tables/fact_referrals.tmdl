table fact_referrals

	column referral_id
		dataType: string
		summarizeBy: none
		sourceColumn: referral_id

	column appointment_id
		dataType: string
		summarizeBy: none
		sourceColumn: appointment_id

	column referred_facility_id
		dataType: string
		summarizeBy: none
		sourceColumn: referred_facility_id

	column link_status
		dataType: string
		summarizeBy: none
		sourceColumn: link_status

	column date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: date

	column from_facility_id
		dataType: string
		summarizeBy: none
		sourceColumn: from_facility_id

	column department_name
		dataType: string
		summarizeBy: none
		sourceColumn: department_name

	column province_name
		dataType: string
		summarizeBy: none
		sourceColumn: province_name

	partition fact_referrals = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_referrals.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"referral_id", type text}, {"appointment_id", type text}, {"referred_facility_id", type text}, {"link_status", type text}, {"date", type date}, {"from_facility_id", type text}, {"department_name", type text}, {"province_name", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
